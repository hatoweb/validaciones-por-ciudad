# Dockerfile para Frontend React
FROM node:18-alpine as build

# Establecer directorio de trabajo
WORKDIR /app

# Copiar todo el código fuente del frontend
COPY REACT/validaciones-frontend/ ./

# Instalar dependencias y asegurar que ajv esté instalado correctamente
RUN npm install --legacy-peer-deps && \
    npm install ajv@^8.12.0 --save --legacy-peer-deps || true

# Construir la aplicación para producción
RUN npm run build

# Stage 2: Servir con nginx
FROM nginx:alpine

# Copiar archivos construidos desde el stage de build
COPY --from=build /app/build /usr/share/nginx/html

# Copiar configuración personalizada de nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Exponer puerto 80
EXPOSE 80

# Comando para ejecutar nginx
CMD ["nginx", "-g", "daemon off;"]

