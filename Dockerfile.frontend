# Dockerfile para Frontend React
FROM node:20-alpine as build

# Establecer directorio de trabajo
WORKDIR /app

# Copiar todo el código fuente del frontend
COPY REACT/validaciones-frontend/ ./

# Limpiar cache de npm e instalar dependencias
RUN npm cache clean --force && \
    npm install --legacy-peer-deps

# Verificar instalación de ajv (necesario para react-scripts)
RUN npm list ajv || npm install ajv@^8.12.0 --legacy-peer-deps

# Construir la aplicación para producción
RUN npm run build

# Stage 2: Servir con nginx
FROM nginx:alpine

# Copiar archivos construidos desde el stage de build
COPY --from=build /app/build /usr/share/nginx/html

# Copiar configuración personalizada de nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Exponer puerto 80
EXPOSE 80

# Comando para ejecutar nginx
CMD ["nginx", "-g", "daemon off;"]

